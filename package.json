{
  "name": "flagforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=flagforge-backend",
    "dev:frontend": "npm run dev --workspace=flagforge-frontend",
    "build": "npm run build --workspaces --if-present",
    "build:sdk": "npm run build --workspace=@flagforge/node-sdk",
    "build:backend": "npm run build --workspace=flagforge-backend",
    "build:frontend": "npm run build --workspace=flagforge-frontend",
    "test": "npm run test --workspace=flagforge-backend && npm run test --workspace=@flagforge/node-sdk",
    "test:backend": "npm run test --workspace=flagforge-backend",
    "test:sdk": "npm run test --workspace=@flagforge/node-sdk"
  }
}
