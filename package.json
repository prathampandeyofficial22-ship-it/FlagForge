{
  "name": "flagforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "build:sdk": "npm run build --workspace=@flagforge/node-sdk",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=@flagforge/node-sdk",
    "test:server": "npm run test --workspace=server",
    "test:sdk": "npm run test --workspace=@flagforge/node-sdk"
  }
}
