# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database (MongoDB)
# Local: mongodb://localhost:27017/flagforge
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/flagforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/flagforge

# Redis Hot-Path Cache
# Set REDIS_ENABLED=false to use built-in in-memory fallback cache (zero Redis setup needed!)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# JWT & Security
JWT_SECRET=flagforge-super-secure-production-jwt-secret-key-32chars!
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
EVALUATION_RATE_LIMIT_MAX=1000
